# Example deployment configuration
# Copy this file to .env and customize for your environment:
# cp .env.example .env

# Target SSH host alias or IP address
DEPLOY_HOST=your-pi-host-or-ip

# Web root directory on the target server
DEPLOY_DEST=/var/www/your-site-path

# Production site URL used for canonical links, sitemaps, and robots.txt
SITE_URL=https://sergisalgueiro.pages.dev


# Optional Google Search Console HTML meta tag verification code
# (If using HTML tag verification method in Google Search Console)
# PUBLIC_GOOGLE_SITE_VERIFICATION=

