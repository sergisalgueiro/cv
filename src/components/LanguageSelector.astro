---
import type { Locale } from '../data/cv';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;

const locales: Array<{ code: Locale; label: string; full: string; path: string }> = [
  { code: 'en', label: 'EN', full: 'English', path: '/' },
  { code: 'ca', label: 'CA', full: 'Català', path: '/ca' },
  { code: 'es', label: 'ES', full: 'Español', path: '/es' },
];
---

<div class="inline-flex items-center rounded-lg border border-zinc-200 bg-zinc-100/80 p-0.5 text-xs font-medium dark:border-zinc-800 dark:bg-zinc-900/80">
  {
    locales.map(({ code, label, full, path }) => {
      const isActive = currentLocale === code;
      return (
        <a
          href={path}
          title={full}
          aria-label={`Switch language to ${full}`}
          class:list={[
            'rounded-md px-2.5 py-1 transition-all duration-150',
            isActive
              ? 'bg-white text-zinc-900 font-semibold shadow-xs dark:bg-zinc-800 dark:text-zinc-100'
              : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200',
          ]}
        >
          {label}
        </a>
      );
    })
  }
</div>
