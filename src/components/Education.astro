---
import type { Locale } from '../data/cv';
import { cvData } from '../data/cv';
import { GraduationCap, BookOpen, Calendar, MapPin, Award } from 'lucide-astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cvData.translations[locale];
---

<section id="education" class="py-12 border-t border-zinc-200 dark:border-zinc-800">
  <div class="space-y-8">
    <!-- Section Heading -->
    <div class="flex items-center gap-3">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">
        {t.education.title}
      </h2>
      <div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></div>
    </div>

    <!-- Education Cards Grid -->
    <div class="grid grid-cols-1 gap-6 sm:gap-8">
      {
        t.education.items.map((item) => (
          <div class="page-break-avoid relative rounded-xl border border-zinc-200 bg-white p-6 shadow-2xs transition-all hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-zinc-700">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 border-b border-zinc-100 pb-4 dark:border-zinc-800/80">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <GraduationCap class="h-5 w-5 text-emerald-600 dark:text-emerald-400" />
                  <h3 class="text-lg font-bold text-zinc-900 dark:text-white sm:text-xl">
                    {item.institution}
                  </h3>
                </div>
                <p class="font-medium text-emerald-600 dark:text-emerald-400 text-sm sm:text-base">
                  {item.degree}
                </p>
                {item.specialization && (
                  <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400">
                    {item.specialization}
                  </p>
                )}
              </div>

              <div class="flex sm:flex-col sm:items-end gap-3 sm:gap-1 text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                <span class="inline-flex items-center gap-1">
                  <Calendar class="h-3.5 w-3.5" />
                  {item.period}
                </span>
                <span class="inline-flex items-center gap-1">
                  <MapPin class="h-3.5 w-3.5" />
                  {item.location}
                </span>
              </div>
            </div>

            <!-- Thesis Highlight -->
            <div class="mt-4 rounded-lg bg-zinc-50 p-3.5 text-xs sm:text-sm text-zinc-700 dark:bg-zinc-950/60 dark:text-zinc-300">
              <div class="flex items-start gap-2">
                <Award class="mt-0.5 h-4 w-4 shrink-0 text-amber-500 dark:text-amber-400" />
                <div class="space-y-0.5">
                  <p class="font-semibold text-zinc-900 dark:text-zinc-100">
                    Thesis: "{item.thesis.title}"
                  </p>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Supervisor: {item.thesis.supervisor}
                  </p>
                </div>
              </div>
            </div>

            <!-- Relevant Courses -->
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                <BookOpen class="h-3.5 w-3.5" />
                <span>Relevant Coursework</span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {
                  item.relevantCourses.map((course) => (
                    <span class="inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-50 px-2 py-0.5 text-xs text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
                      {course}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
