---
import type { Locale } from '../data/cv';
import { cvData } from '../data/cv';
import { Cloud, Printer } from 'lucide-astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cvData.translations[locale];
const currentYear = new Date().getFullYear();
---

<footer class="no-print mt-16 border-t border-zinc-200 py-10 dark:border-zinc-800">
  <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left text-xs text-zinc-500 dark:text-zinc-400">
    <!-- Hosting Note -->
    <div class="flex items-center gap-2">
      <Cloud class="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
      <span>{t.footer.hostedOn}</span>
    </div>

    <!-- Print Tip -->
    <div class="flex items-center gap-2">
      <Printer class="h-3.5 w-3.5" />
      <span>{t.footer.printFriendly}</span>
    </div>

    <!-- Copyright -->
    <div>
      © {currentYear} {cvData.meta.name}. All rights reserved.
    </div>
  </div>
</footer>
