---
import type { Locale } from '../data/cv';
import { cvData } from '../data/cv';
import { Cpu } from 'lucide-astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cvData.translations[locale];
---

<section id="skills" class="py-12 border-t border-zinc-200 dark:border-zinc-800">
  <div class="space-y-8">
    <!-- Section Heading -->
    <div class="flex items-center gap-3">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">
        {t.skills.title}
      </h2>
      <div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800"></div>
    </div>

    <!-- Categorized Skills Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        t.skills.categories.map((category) => (
          <div class="page-break-avoid rounded-xl border border-zinc-200 bg-white p-5 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900/50">
            <div class="flex items-center gap-2 border-b border-zinc-100 pb-3 dark:border-zinc-800">
              <Cpu class="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
              <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 dark:text-zinc-200">
                {category.name}
              </h3>
            </div>
            <div class="flex flex-wrap gap-2 pt-4">
              {
                category.items.map((skill) => (
                  <span class="inline-flex items-center rounded-lg border border-zinc-200/90 bg-zinc-50 px-3 py-1 font-mono text-xs font-medium tracking-tight text-zinc-800 shadow-2xs transition-colors hover:border-emerald-500/50 hover:bg-emerald-50/50 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-200 dark:hover:border-emerald-500/50 dark:hover:bg-emerald-950/30">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
