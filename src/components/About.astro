---
import type { Locale } from '../data/cv';
import { cvData } from '../data/cv';
import { Mail, Linkedin, Github, Download, Copy, Check, MapPin, Briefcase } from 'lucide-astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cvData.translations[locale];
const meta = cvData.meta;
---

<section id="about" class="pt-8 pb-12 sm:pt-14 sm:pb-16">
  <div class="space-y-6">
    <!-- Header info & Badges -->
    <div class="flex flex-col-reverse justify-between gap-6 sm:flex-row sm:items-start">
      <div class="space-y-2">
        <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl lg:text-5xl dark:text-white">
          {meta.name}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-base font-medium text-emerald-600 dark:text-emerald-400">
          <span class="flex items-center gap-1.5">
            <Briefcase class="h-4 w-4" />
            {meta.title}
          </span>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <span class="flex items-center gap-1.5 text-zinc-600 dark:text-zinc-400">
            <MapPin class="h-4 w-4" />
            {meta.location}
          </span>
        </div>
      </div>

      <!-- Quick Status Badge -->
      <div class="no-print inline-flex self-start items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-50/60 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-950/40 dark:text-emerald-300">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Open to Opportunities</span>
      </div>
    </div>

    <!-- Lead / Bio Paragraphs -->
    <div class="space-y-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
      <p class="font-medium text-zinc-900 dark:text-zinc-100">
        {t.about.lead}
      </p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        {t.about.bio}
      </p>
    </div>

    <!-- Actions & Social Links Bar -->
    <div class="flex flex-wrap items-center gap-2.5 pt-2">
      <!-- Download PDF Button -->
      <a
        href={meta.pdfFileName}
        download="Sergi_Salgueiro_CV.pdf"
        class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white shadow-xs transition-all hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-900 focus:ring-offset-2 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100 dark:focus:ring-white dark:focus:ring-offset-zinc-950"
      >
        <Download class="h-4 w-4" />
        <span>{t.about.downloadPdf}</span>
      </a>

      <!-- Email action group: Mailto link + Attached Copy button -->
      <div class="inline-flex items-stretch rounded-lg border border-zinc-200 bg-white shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
        <a
          href={`mailto:${meta.email}`}
          title="Send email"
          class="inline-flex items-center gap-2 rounded-l-lg px-3.5 py-2.5 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white"
        >
          <Mail class="h-4 w-4" />
          <span>{meta.email}</span>
        </a>
        <div class="w-px bg-zinc-200 dark:bg-zinc-800 my-1.5"></div>
        <button
          id="copy-email-btn"
          type="button"
          data-email={meta.email}
          data-copied-text={locale === 'ca' ? 'Copiat!' : locale === 'es' ? '¡Copiado!' : 'Copied!'}
          title={t.about.copyEmail}
          aria-label={t.about.copyEmail}
          class="no-print group relative inline-flex items-center justify-center gap-1.5 rounded-r-lg px-2.5 text-xs font-medium text-zinc-500 transition-colors hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
        >
          <Copy id="copy-icon" class="h-3.5 w-3.5 transition-transform group-hover:scale-110" />
          <Check id="check-icon" class="hidden h-3.5 w-3.5 text-emerald-500" />
          <span id="copy-label" class="hidden sm:inline">{locale === 'ca' ? 'Copiar' : locale === 'es' ? 'Copiar' : 'Copy'}</span>
        </button>
      </div>

      <!-- LinkedIn -->
      <a
        href={meta.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.about.viewLinkedin}
        title="LinkedIn Profile"
        class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3.5 py-2.5 text-sm font-medium text-zinc-700 shadow-2xs transition-colors hover:bg-zinc-50 hover:text-blue-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-blue-400"
      >
        <Linkedin class="h-4 w-4" />
        <span class="hidden sm:inline">LinkedIn</span>
      </a>

      <!-- GitHub -->
      <a
        href={meta.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.about.viewGithub}
        title="GitHub Profile"
        class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3.5 py-2.5 text-sm font-medium text-zinc-700 shadow-2xs transition-colors hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white"
      >
        <Github class="h-4 w-4" />
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>

    <!-- Notification Toast for Copied Email -->
    <div
      id="copy-toast"
      class="no-print fixed bottom-6 right-6 z-50 hidden items-center gap-2 rounded-xl bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white shadow-xl dark:bg-zinc-100 dark:text-zinc-900"
    >
      <Check class="h-4 w-4 text-emerald-400 dark:text-emerald-600" />
      <span>{t.about.emailCopied}</span>
    </div>
  </div>
</section>

<script is:inline>
  function setupEmailCopy() {
    const btn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('copy-toast');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    const copyLabel = document.getElementById('copy-label');

    if (!btn || !toast) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      const copiedText = btn.getAttribute('data-copied-text') || 'Copied!';
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);

        const originalLabel = copyLabel ? copyLabel.textContent : '';
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (copyLabel) {
          copyLabel.textContent = copiedText;
          copyLabel.classList.add('text-emerald-500');
        }
        toast.classList.remove('hidden');
        toast.classList.add('flex');

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (copyLabel) {
            copyLabel.textContent = originalLabel;
            copyLabel.classList.remove('text-emerald-500');
          }
          toast.classList.remove('flex');
          toast.classList.add('hidden');
        }, 2500);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }

  setupEmailCopy();
  document.addEventListener('astro:after-swap', setupEmailCopy);
</script>
